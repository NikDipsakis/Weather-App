{"source":"style.css","name":null,"original":{"line":341,"column":2},"generated":{"line":1,"column":3800}},{"source":"style.css","name":null,"original":{"line":341,"column":39},"generated":{"line":1,"column":3830}},{"source":"style.css","name":null,"original":{"line":342,"column":2},"generated":{"line":1,"column":3831}},{"source":"style.css","name":null,"original":{"line":342,"column":12},"generated":{"line":1,"column":3840}},{"source":"style.css","name":null,"original":{"line":343,"column":2},"generated":{"line":1,"column":3841}},{"source":"style.css","name":null,"original":{"line":344,"column":0},"generated":{"line":1,"column":3859}},{"source":"style.css","name":null,"original":{"line":346,"column":0},"generated":{"line":1,"column":3860}},{"source":"style.css","name":null,"original":{"line":348,"column":2},"generated":{"line":1,"column":3870}},{"source":"style.css","name":null,"original":{"line":349,"column":0},"generated":{"line":1,"column":3893}}],"sources":{"style.css":"* {\r\n  margin: 0;\r\n  padding: 0;\r\n  box-sizing: border-box;\r\n  font-family: \"Segoe UI\", sans-serif;\r\n}\r\n\r\nbody {\r\n  height: 100vh;\r\n  overflow: hidden;\r\n  color: white;\r\n}\r\n\r\n.loading-screen {\r\n  position: fixed;\r\n  inset: 0;\r\n\r\nbackground:\r\n  radial-gradient(circle at 20% 30%, #cbd5f510, transparent 40%),\r\n  radial-gradient(circle at 80% 70%, #70acff3f, transparent 50%),\r\n  linear-gradient(135deg, #020617, #263e72, #020617);\r\n  background-size: 200% 200%;\r\n\r\n  animation: gradientMove 10s ease infinite;\r\n\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n\r\n  z-index: 9999;\r\n}\r\n@keyframes gradientMove {\r\n  0% {\r\n    background-position:\r\n      0% 50%,\r\n      100% 50%,\r\n      0% 50%;\r\n  }\r\n  50% {\r\n    background-position:\r\n      100% 50%,\r\n      0% 50%,\r\n      100% 50%;\r\n  }\r\n  100% {\r\n    background-position:\r\n      0% 50%,\r\n      100% 50%,\r\n      0% 50%;\r\n  }\r\n}\r\n\r\n/* hidden state */\r\n.loading-screen.hidden {\r\n  opacity: 0;\r\n  visibility: hidden;\r\n}\r\n\r\n.loading-screen::after {\r\n  content: \"Loading...\";\r\n  position: absolute;\r\n  bottom: 20%;\r\n  color: #66b4e9;\r\n  font-size: 14px;\r\n  letter-spacing: 2px;\r\n   animation: loadingPulse 1.4s ease-in-out infinite;\r\n}\r\n\r\n@keyframes loadingPulse {\r\n  0%, 100% {\r\n    opacity: 0.3;\r\n    transform: translateY(0);\r\n    letter-spacing: 2px;\r\n  }\r\n  50% {\r\n    opacity: 1;\r\n    transform: translateY(0px);\r\n    letter-spacing: 3px;\r\n  }\r\n}\r\n\r\n.loader-icon {\r\n  position: absolute;\r\n  width: 100px;\r\n  height: 100px;\r\n\r\n  opacity: 0;\r\n  transform: scale(0.8);\r\n\r\n  transition:\r\n    opacity 0.6s ease,\r\n    transform 0.6s ease;\r\n}\r\n\r\n/* active icon */\r\n.loader-icon.active {\r\n  opacity: 1;\r\n  transform: scale(1);\r\n}\r\n\r\n.loader-icon {\r\n  transform: translateY(20px) scale(0.9);\r\n}\r\n\r\n.loader-icon.active {\r\n  transform: translateY(0) scale(1);\r\n}\r\n\r\n/* Background */\r\n.background {\r\n  position: absolute;\r\n  width: 100%;\r\n  height: 100%;\r\n  transition: background 0.8s ease;\r\n  filter: blur(10px);\r\n  transform: scale(1.1);\r\n}\r\n\r\n/* MAIN APP */\r\n.app {\r\n  position: relative;\r\n  z-index: 2;\r\n\r\n  width: 900px;\r\n  height: 500px;\r\n\r\n  margin: auto;\r\n  top: 50%;\r\n  transform: translateY(-50%);\r\n\r\n  display: grid;\r\n  grid-template-columns: 1fr 2fr 1fr;\r\n  grid-template-rows: auto 1fr auto;\r\n\r\n  border-radius: 20px;\r\n  padding: 30px;\r\n\r\n  background: rgba(0, 0, 0, 0.4);\r\n  backdrop-filter: blur(20px);\r\n}\r\n\r\n\r\n\r\n.main-icon {\r\n  transition:\r\n    transform 0.3s ease,\r\n    opacity 0.3s ease;\r\n}\r\n\r\n.main-icon:hover {\r\n  transform: scale(1.05);\r\n}\r\n\r\n/* TOP BAR */\r\n.top-bar {\r\n  grid-column: span 3;\r\n\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n\r\n  margin-bottom: 20px;\r\n}\r\n\r\n/* City display */\r\n.city-display {\r\n  font-size: 23px;\r\n  font-weight: 300;\r\n  opacity: 0.9;\r\n}\r\n\r\n/* Search */\r\n.search {\r\n  display: flex;\r\n  gap: 10px;\r\n}\r\n\r\n.search ::placeholder {\r\n  color: white;\r\n}\r\n\r\n.search input {\r\n  padding: 8px 12px;\r\n  border-radius: 8px;\r\n  border: none;\r\n  outline: none;\r\n\r\n  background: rgba(255, 255, 255, 0.178);\r\n  color: rgb(255, 255, 255);\r\n}\r\n\r\n.search button {\r\n  padding: 8px 12px;\r\n  border-radius: 8px;\r\n  border: none;\r\n  cursor: pointer;\r\n  transition: all 0.2s ease;\r\n  background: rgba(255, 255, 255, 0.2);\r\n  color: white;\r\n}\r\n\r\n/* Hover */\r\n.search button:hover {\r\n  background: rgba(255, 255, 255, 0.3);\r\n  transform: translateY(-1px);\r\n}\r\n\r\n/* LEFT */\r\n.left {\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: center;\r\n}\r\n\r\n.temp {\r\n  font-size: 100px;\r\n  font-weight: 200;\r\n}\r\n\r\n.status {\r\n  font-size: 20px;\r\n  opacity: 0.8;\r\n  margin: 10px 0;\r\n}\r\n\r\n.details {\r\n  font-size: 14px;\r\n  opacity: 0.6;\r\n}\r\n\r\n/* CENTER */\r\n.center {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n.main-icon {\r\n  width: 180px;\r\n}\r\n\r\n/* RIGHT */\r\n.right {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 10px;\r\n  justify-content: center;\r\n}\r\n\r\n.day {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  padding: 10px;\r\n  transition: all 0.2s ease;\r\n  border-radius: 10px;\r\n  opacity: 0.7;\r\n  border: 1px solid transparent;\r\n}\r\n\r\n.day:hover {\r\n  background: rgba(255, 255, 255, 0.136);\r\n  transform: translateX(3px);\r\n}\r\n\r\n.day p {\r\n  font-size: 17px;\r\n}\r\n\r\n.day span {\r\n  font-size: 15px;\r\n  opacity: 1;\r\n}\r\n\r\n.day.active {\r\n  background: rgba(255, 255, 255, 0.247);\r\n  transform: scale(1.05);\r\n}\r\n\r\n.day.active:hover {\r\n  background: rgba(255, 255, 255, 0.308);\r\n  transform: scale(1.08);\r\n}\r\n.day,\r\n.hour,\r\n.search button {\r\n  cursor: pointer;\r\n}\r\n.hour {\r\n  transition: all 0.2s ease;\r\n}\r\n\r\n.hour:hover {\r\n  background: rgba(255, 255, 255, 0.08);\r\n  transform: translateY(-2px);\r\n}\r\n\r\n/* BOTTOM */\r\n.bottom {\r\n  grid-column: span 3;\r\n\r\n  display: flex;\r\n  gap: 80px;\r\n\r\n  overflow-x: auto;\r\n  padding-top: 15px;\r\n  font-size: 14px;\r\n  opacity: 1;\r\n  scrollbar-width: none; /* Firefox */\r\n  scroll-behavior: smooth;\r\n  scroll-snap-type: x mandatory;\r\n}\r\n\r\n.bottom::-webkit-scrollbar {\r\n  display: none; /* Chrome */\r\n}\r\n.hour {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  min-width: 70px;\r\n  padding: 10px;\r\n  border-radius: 12px;\r\n  background: rgba(255, 255, 255, 0.05);\r\n  transition: all 0.3s ease;\r\n  scroll-snap-align: center;\r\n  opacity: 0.7;\r\n}\r\n\r\n.hour:hover {\r\n  background: rgba(255, 255, 255, 0.1);\r\n  transform: translateY(-3px);\r\n  opacity: 1;\r\n}\r\n\r\n.hour img {\r\n  width: 50px;\r\n  margin: 5px 0;\r\n}\r\n\r\n.active-hour {\r\n  background: rgba(255, 255, 255, 0.15);\r\n  opacity: 1;\r\n  transform: scale(1);\r\n}\r\n/* Smooth */\r\n.app,\r\n.day {\r\n  transition: all 0.3s ease;\r\n}\r\n"},"lineCount":null}},"error":null,"hash":"3f34cd0ad8f1d727c4a56e27a987bb05","cacheData":{"env":{}}}